# Normalize every production source and resource input before reproducible JAR
# packaging. The tracked installable JAR itself must remain binary.
* text=auto eol=lf
*.jar binary
*.png binary

# Generated resources are already produced with LF; keep that explicit for
# tooling that handles generated paths separately.
src/generated/**/.cache/* text eol=lf
src/generated/**/*.json text eol=lf
